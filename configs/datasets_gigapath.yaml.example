# GigaPath tile-feature roots for the local 10-task WSI stream.
# Copy to configs/datasets_gigapath.yaml and adjust paths on another machine.
# The two coordinate columns are preserved exactly as stored by extraction.
data_root: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset_gigapath
require_unique_positional_grid: true

task_order: [camelyon17, brca, rcc, nsclc, esca, tgct, cesc, bracs, herohe, ubc_ocean]
reverse_task_order: false

annotations:
  camelyon17: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/slide_level_labels_all.csv
  brca: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/tcga_brca/tcga_brca_subset.csv
  rcc: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/tcga_rcc/tcga_kidney_subset.csv
  nsclc: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/tcga_nsclc/tcga_lung_subset.csv
  bracs: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/brcas.csv
  herohe: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/herohe.csv
  ubc_ocean: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/ubc_ocean_clean.csv

features:
  camelyon17: "{data_root}/CAMELYON17/features_gigapath"
  brca: "{data_root}/BRCA_RCC_NSCLC/features_gigapath"
  rcc: "{data_root}/BRCA_RCC_NSCLC/features_gigapath"
  nsclc: "{data_root}/BRCA_RCC_NSCLC/features_gigapath"
  esca: "{data_root}/ESCA_CESC_TGCT/features_gigapath"
  tgct: "{data_root}/ESCA_CESC_TGCT/features_gigapath"
  cesc: "{data_root}/ESCA_CESC_TGCT/features_gigapath"
  bracs: "{data_root}/BRACS/features_gigapath"
  herohe: "{data_root}/HEROHE/train/features_gigapath"
  ubc_ocean: "{data_root}/UBC-OCEAN/features_gigapath"

split_dirs:
  camelyon17: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/task_camelyon17
  brca: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/tcga_brca
  rcc: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/tcga_rcc
  nsclc: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/tcga_nsclc
  esca: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/tcga_esca
  tgct: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/tcga_tgct
  cesc: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/tcga_cesc
  bracs: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/task_bracs
  herohe: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/task_herohe
  ubc_ocean: /mmlab_students/storageStudents/nguyenvd/Thuchd/Benchmark_WSI/dataset/split/task_ubc_ocean
